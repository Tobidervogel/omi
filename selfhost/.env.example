# Einstellungen für Omi im Selbstbetrieb. Nicht von Hand kopieren: "python einrichten.py" erzeugt
# daraus selfhost/.env mit echten Zufallswerten. .env gehört nicht ins Git (steht in .gitignore).

# Adresse des PCs im Heimnetz, unter der Handy und recorder.py das Backend erreichen.
OMI_PC_ADRESSE=192.168.0.23

# Geheimnisse (einrichten.py erzeugt sie). OMI_VERSCHLUESSELUNG verschlüsselt die gespeicherten
# Unterhaltungen: geht sie verloren, sind die Daten nicht mehr lesbar. .env mitsichern.
OMI_VERSCHLUESSELUNG=<wird erzeugt>
OMI_GATEWAY_SCHLUESSEL=<wird erzeugt>
OMI_TYPESENSE_SCHLUESSEL=<wird erzeugt>

# Sprachmodell. Standard: Ollama direkt unter Windows.
#   Ollama im Container (docker compose --profile ollama up -d):  http://ollama:11434/v1
#   Cloud-Rückfall OpenAI:                                         https://api.openai.com/v1
OMI_LLM_URL=http://host.docker.internal:11434/v1
# Für Ollama beliebig; für OpenAI hier den eigenen API-Schlüssel eintragen.
OMI_LLM_SCHLUESSEL=ollama
# Verlängert alle Zeitgrenzen für Modellaufrufe (Omis Grenzen gelten für schnelle Cloud-Modelle).
# 30 für die GTX 980, 100 oder mehr nur mit CPU, 1 in der Cloud. Der Messlauf zeigt, ob es reicht.
OMI_LLM_ZEITFAKTOR=30

# Wo die Daten liegen (Datenbank-Sicherungen, Vektoren, Ablage, Suche). Relativ zu selfhost/.
OMI_DATEN=./daten
# Wie oft die Datenbank gesichert wird und wie viele Sicherungen bleiben (48 x 10 min = 8 Stunden).
OMI_SICHERN_ALLE_MINUTEN=10
OMI_SICHERUNGEN_BEHALTEN=48
